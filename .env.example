# Server-only quant service configuration. Never use NEXT_PUBLIC_ for the key.
ETESIA_API_URL=https://your-quant-api.example
ETESIA_API_KEY=
# Server-only bearer key of the quant service's testnet liquidity top-up
# (POST /v1/testnet/liquidity); the same value as ETESIA_LIQUIDITY_API_KEY on the quant service.
ETESIA_LIQUIDITY_API_KEY=
# Server-only Soroswap Aggregator API key, used by /api/soroswap for testnet swaps.
SOROSWAP_API_KEY=
